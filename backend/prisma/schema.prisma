// Prisma shema za Fakturko – sledi docs/03-podatkovni-model.md
// Polja so v kodi camelCase, stolpci v bazi snake_case (@map), tabele v množini (@@map).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enumi ----------

enum FirmRole {
  ADMIN
  ACCOUNTANT
}

enum PaymentMode {
  ACCOUNTANT_PAYS
  CLIENT_PAYS
}

enum InvoiceStatus {
  UPLOADED
  PROCESSING
  IN_REVIEW
  RETURNED
  REJECTED
  READY_FOR_PAYMENT
  PAID
  ARCHIVED
}

enum ExtractionMethod {
  UPN_QR
  AI
  MANUAL
}

enum DocumentKind {
  ORIGINAL
  PAYMENT_CONFIRMATION
}

// ---------- Modeli ----------

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  firmRole     FirmRole? @map("firm_role")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships       ClientMembership[]
  assignments       AccountantAssignment[]
  uploadedInvoices  Invoice[]              @relation("InvoiceUploadedBy")
  reviewedInvoices  Invoice[]              @relation("InvoiceReviewedBy")
  paidInvoices      Invoice[]              @relation("InvoicePaidBy")
  uploadedDocuments Document[]
  notifications     Notification[]

  @@map("users")
}

model Client {
  id                 String      @id @default(uuid()) @db.Uuid
  name               String
  taxNumber          String      @unique @map("tax_number")
  registrationNumber String?     @map("registration_number")
  address            String
  iban               String
  paymentMode        PaymentMode @default(ACCOUNTANT_PAYS) @map("payment_mode")
  slug               String      @unique
  isActive           Boolean     @default(true) @map("is_active")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships ClientMembership[]
  assignments AccountantAssignment[]
  invoices    Invoice[]

  @@map("clients")
}

model ClientMembership {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user   User   @relation(fields: [userId], references: [id])
  client Client @relation(fields: [clientId], references: [id])

  @@unique([userId, clientId])
  @@map("client_memberships")
}

model AccountantAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  accountantId String   @map("accountant_id") @db.Uuid
  clientId     String   @map("client_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  accountant User   @relation(fields: [accountantId], references: [id])
  client     Client @relation(fields: [clientId], references: [id])

  @@unique([accountantId, clientId])
  @@map("accountant_assignments")
}

model Invoice {
  id                   String            @id @default(uuid()) @db.Uuid
  clientId             String            @map("client_id") @db.Uuid
  uploadedById         String            @map("uploaded_by_id") @db.Uuid
  status               InvoiceStatus     @default(UPLOADED)
  extractionMethod     ExtractionMethod? @map("extraction_method")
  extractionConfidence Json?             @map("extraction_confidence")
  issuerName           String?           @map("issuer_name")
  issuerTaxNumber      String?           @map("issuer_tax_number")
  issuerIban           String?           @map("issuer_iban")
  recipientName        String?           @map("recipient_name")
  invoiceNumber        String?           @map("invoice_number")
  issueDate            DateTime?         @map("issue_date") @db.Date
  dueDate              DateTime?         @map("due_date") @db.Date
  amount               Decimal?          @db.Decimal(12, 2)
  currency             String            @default("EUR") @db.Char(3)
  paymentReference     String?           @map("payment_reference")
  paymentPurpose       String?           @map("payment_purpose")
  reviewedById         String?           @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?         @map("reviewed_at") @db.Timestamptz
  paidById             String?           @map("paid_by_id") @db.Uuid
  paidOn               DateTime?         @map("paid_on") @db.Date
  statusReason         String?           @map("status_reason")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  client     Client @relation(fields: [clientId], references: [id])
  uploadedBy User   @relation("InvoiceUploadedBy", fields: [uploadedById], references: [id])
  reviewedBy User?  @relation("InvoiceReviewedBy", fields: [reviewedById], references: [id])
  paidBy     User?  @relation("InvoicePaidBy", fields: [paidById], references: [id])

  documents     Document[]
  notifications Notification[]

  // Za zaznavanje podvojenih računov (ni omejitev enoličnosti, samo opozorilo)
  @@index([clientId, issuerTaxNumber, invoiceNumber])
  @@index([status])
  @@map("invoices")
}

model Document {
  id               String       @id @default(uuid()) @db.Uuid
  invoiceId        String       @map("invoice_id") @db.Uuid
  kind             DocumentKind
  storageKey       String       @unique @map("storage_key")
  originalFilename String       @map("original_filename")
  mimeType         String       @map("mime_type")
  sizeBytes        Int          @map("size_bytes")
  sha256           String       @db.Char(64)
  uploadedById     String       @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@map("documents")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  invoiceId String?   @map("invoice_id") @db.Uuid
  type      String
  message   String
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user    User     @relation(fields: [userId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@map("notifications")
}
