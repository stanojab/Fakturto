# PostgreSQL
POSTGRES_USER=fakturko
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fakturko

# Backend
PORT=3000

# Prisma (backend)
DATABASE_URL=postgresql://fakturko:change-me@localhost:5432/fakturko?schema=public

# Prijava (JWT) – dolg naključen niz, npr.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
